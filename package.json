{
  "name": "playtomic",
  "version": "0.1.0",
  "description": "Unofficial Playtomic client for Node.js, with support for sending user and match chat messages.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albyonl/playtomic-node.git"
  },
  "bugs": {
    "url": "https://github.com/albyonl/playtomic-node/issues"
  },
  "homepage": "https://github.com/albyonl/playtomic-node#readme",
  "keywords": [
    "playtomic",
    "chat",
    "padel",
    "typescript",
    "nodejs"
  ],
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --dts && node dist/index.cjs",
    "start": "node dist/index.cjs"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "firebase": "^12.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "tsup": "^6.0.0",
    "typescript": "^5.0.0"
  }
}
